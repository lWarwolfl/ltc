  },
  {
   "type": "h2",
   "text": "RegExp \\uhhhh (unicode hex)"
  },
  {
   "type": "p",
   "text": "\\uhhhh matches a Unicode character by the hex number hhhh."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"Visit W3Schools. Hello World!\";\n\nconst pattern = /\\u0057/g;\n\nlet result = text.match(pattern);",
