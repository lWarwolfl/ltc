{
 "slug": "js_window_screen",
 "course": "js",
 "order": 160,
 "url": "/js/js_window_screen.asp",
 "title": "JavaScript Window Screen",
 "blocks": [
  {
   "type": "h1",
   "text": "JavaScript Window Screen"
  },
  {
   "type": "p",
   "text": "The window.screen object contains information\nabout the user's screen."
  },
  {
   "type": "h2",
   "text": "Window Screen"
  },
  {
   "type": "p",
   "text": "The window.screen object can be written without the window prefix."
  },
  {
   "type": "p",
   "text": "Properties:"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "screen.width",
    "screen.height",
    "screen.availWidth",
    "screen.availHeight",
    "screen.colorDepth",
    "screen.pixelDepth"
   ]
  },
  {
   "type": "h2",
   "text": "Window Screen Width"
  },
  {
   "type": "p",
   "text": "The screen.width property returns the width of the visitor's screen in\npixels."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Screen Width: \" + screen.width;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_width"
  },
  {
   "type": "h2",
   "text": "Window Screen Height"
  },
  {
   "type": "p",
   "text": "The screen.height property returns the height of the visitor's screen in pixels."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Screen Height: \" + screen.height;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_height"
  },
  {
   "type": "h2",
   "text": "Window Screen Available Width"
  },
  {
   "type": "p",
   "text": "The screen.availWidth property returns the width of the visitor's screen, in\npixels,\nminus interface features like the Windows Taskbar."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Available Screen Width: \" + screen.availWidth;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_availwidth"
  },
  {
   "type": "h2",
   "text": "Window Screen Available Height"
  },
  {
   "type": "p",
   "text": "The screen.availHeight property returns the height of the visitor's screen,\nin pixels, minus interface features like the Windows Taskbar."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Available Screen Height: \" + screen.availHeight;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_availheight"
  },
  {
   "type": "h2",
   "text": "Window Screen Color Depth"
  },
  {
   "type": "p",
   "text": "The screen.colorDepth property returns the number of bits used to display one color."
  },
  {
   "type": "p",
   "text": "All modern computers use 24 bit or 32 bit hardware for color resolution:"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "24 bits =      16,777,216 different \"True Colors\"",
    "32 bits = 4,294,967,296 different \"Deep Colors\""
   ]
  },
  {
   "type": "p",
   "text": "Older computers used 16 bits: 65,536 different \"High Colors\" resolution."
  },
  {
   "type": "p",
   "text": "Very old computers, and old cell phones used 8 bits: 256 different \"VGA colors\"."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Screen Color Depth: \" + screen.colorDepth;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_colorDepth"
  },
  {
   "type": "note",
   "variant": "note",
   "text": "The #rrggbb (rgb) values used in HTML represents \"True Colors\" (16,777,216 different colors)"
  },
  {
   "type": "h2",
   "text": "Window Screen Pixel Depth"
  },
  {
   "type": "p",
   "text": "The screen.pixelDepth property returns the pixel depth of the screen."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "document.getElementById(\"demo\").innerHTML =\n\"Screen Pixel Depth: \" + screen.pixelDepth;",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_screen_pixelDepth"
  },
  {
   "type": "note",
   "variant": "note",
   "text": "For modern computers, Color Depth and Pixel Depth are equal."
  }
 ]
}