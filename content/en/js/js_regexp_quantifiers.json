  {
   "type": "h2",
   "text": "RegExp Quantifiers"
  },
  {
   "type": "p",
   "text": "Regular Expression (Regex) quantifiers define how many times the preceding character, group, or character class must occur in a string. They control the boundaries of your matches, allowing patterns to be flexible."
  },
  {
   "type": "p",
   "text": "// Match at least one zero\nconst pattern = /0+/;"
  },
  {
   "type": "h2",
   "text": "JavaScript RexExp Quantifiers"
  },
  {
   "type": "h2",
   "text": "Revised July 2025"
  },
  {
   "type": "table",
   "headers": [],
   "rows": [
    [
     "Code",
     "Description"
    ],
    [
     "x+",
     "Matches at least one x"
    ],
    [
     "x*",
     "Matches zero or more occurrences of x"
    ],
    [
     "x?",
     "Matches zero or one occurrences of x"
    ],
    [
     "x{n}",
     "Matches n occurences of x"
    ],
    [
     "x{n,m}",
     "Matches from n to m occurences of x"
    ],
    [
     "x{n,}",
     "Matches n or more occurences of x"
    ]
   ]
  },
  {
   "type": "h2",
   "text": "RegExp + Quantifier"
  },
  {
   "type": "p",
   "text": "x+ matches matches at least one x."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"Hellooo World! Hello W3Schools!\";\n\nconst pattern = /o+/g;\n\nlet result = text.match(pattern);",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_n1"
  },
  {
   "type": "h2",
   "text": "RegExp * Quantifier"
  },
  {
   "type": "p",
   "text": "x* matches zero or more occurrences of x."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"Hellooo World! Hello W3Schools!\";\n\nconst pattern = /lo*/g;\n\nlet result = text.match(pattern);",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_n2"
  },
  {
   "type": "h2",
   "text": "RegExp ? Quantifier"
  },
  {
   "type": "p",
   "text": "x? matches zero or one occurrences of x."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"1, 100 or 1000?\";\n\nconst pattern = /10?/g;\n\nlet result = text.match(pattern);",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_n3"
  },
  {
   "type": "h2",
   "text": "RegExp {n} Quantifier"
  },
  {
   "type": "p",
   "text": "x{n} matches n occurences of x."
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"100, 1000 or 10000?\";\n\nlet pattern = /\\d{4}/g;\n\nlet result = text.match(pattern);",
   "caption": null
  },
