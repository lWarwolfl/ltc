     "Returns an Array of results"
    ],
    [
     "matchAll(regex)",
     "Returns an Iterator of results"
    ],
    [
     "replace(regex)",
     "Returns a new String"
    ],
    [
     "replaceAll(regex)",
     "Returns a new String"
    ],
    [
     "search(regex)",
     "Returns the index of the first match"
    ],
    [
