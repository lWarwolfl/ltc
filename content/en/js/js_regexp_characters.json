 "title": "RegExp Character Classes",
 "blocks": [
  {
   "type": "h1",
   "text": "RegExp Character Classes"
  },
  {
   "type": "p",
   "text": "Character Classes are characters enclosed in square brackets []."
  },
  {
   "type": "p",
   "text": "A character class matches any character from a set within brackets:"
  },
  {
   "type": "p",
   "text": "// Match Digits\nconst pattern = /[0-9]/;"
  },
  {
   "type": "h2",
   "text": "JavaScript Regex Character Classes"
  },
  {
   "type": "h2",
   "text": "Revised July 2025"
  },
  {
   "type": "table",
   "headers": [],
   "rows": [
    [
     "Class",
     "Description"
    ],
    [
     "[a]",
     "Matches the character between the brackets"
    ],
    [
     "[^a]",
     "Matches all characters NOT between the brackets"
    ],
    [
     "[abc]",
     "Matches all characters between the brackets"
    ],
    [
     "[^abc]",
     "Matches all characters NOT between the brackets"
    ],
    [
     "[a-z]",
     "Matches all characters in the range from a to z"
    ],
    [
     "[^a-z]",
     "Matches all characters NOT in the range from a to z"
    ],
    [
     "[0-9]",
     "Matches all characters in the range from 0 to 9"
    ],
    [
     "[^0-9]",
     "Matches all characters NOT in the range from 0 to 9"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"Hello World!\";\n\nconst pattern = /[HW]/g;\n\nlet result = text.match(pattern);",
   "caption": "Example [HW]"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_abc_2"
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"This is W3School\";\n\nconst pattern = /[A-Z]/g;\n\nlet result = text.match(pattern);",
   "caption": "Example [A-Z]"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_a-z"
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"123456789\";\n\nconst pattern = /[1234]/g;\n\nlet result = text.match(pattern);",
   "caption": "Example [1234]"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_regexp_0-9_2"
  },
  {
   "type": "code",
   "lang": "js",
   "text": "let text = \"123456789\";\n\nconst pattern = /[1-4]/g;\n\nlet result = text.match(pattern);",
   "caption": "Example [1-4]"
  },
  {
   "type": "tryit",
