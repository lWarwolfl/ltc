{
  "slug": "js_jquery_elements",
  "course": "js",
  "order": 266,
  "url": "/js/js_jquery_elements.asp",
  "title": "jQuery HTML Elements",
  "blocks": [
    {
      "type": "h1",
      "text": "jQuery HTML Elements"
    },
    {
      "type": "h2",
      "text": "jQuery vs JavaScript"
    },
    {
      "type": "p",
      "text": "jQuery was created in 2006 by John Resig.\nIt was designed to handle Browser Incompatibilities and to simplify HTML DOM Manipulation, Event Handling, Animations, and Ajax."
    },
    {
      "type": "p",
      "text": "However, after JavaScript Version 5 (2009), most of the jQuery utilities can be solved with a few lines of standard JavaScript:"
    },
    {
      "type": "h2",
      "text": "Set Text Content"
    },
    {
      "type": "p",
      "text": "Set the inner text of an HTML element:"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myElement.text(\"Hello Sweden!\");",
      "caption": "jQuery"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_settext"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myElement.textContent = \"Hello Sweden!\";",
      "caption": "JavaScript"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_dom_settext"
    },
    {
      "type": "h2",
      "text": "Get Text Content"
    },
    {
      "type": "p",
      "text": "Get the inner text of an HTML element:"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myText = $(\"#02\").text();",
      "caption": "jQuery"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_gettext"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myText = document.getElementById(\"02\").textContent;",
      "caption": "JavaScript"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_dom_gettext"
    },
    {
      "type": "h2",
      "text": "Set HTML Content"
    },
    {
      "type": "p",
      "text": "Set the HTML content of an element:"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myElement.html(\"<p>Hello World</p>\");",
      "caption": "jQuery"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_sethtml"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "myElement.innerHTML = \"<p>Hello World</p>\";",
      "caption": "JavaScript"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_dom_sethtml"
    },
    {
      "type": "h2",
      "text": "Get HTML Content"
    },
    {
      "type": "p",
      "text": "Get the HTML content of an element:"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "content = myElement.html();",
      "caption": "jQuery"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_gethtml"
    },
    {
      "type": "code",
      "lang": "js",
      "text": "content = myElement.innerHTML;",
      "caption": "JavaScript"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_jquery_dom_gethtml"
    }
  ]
}
