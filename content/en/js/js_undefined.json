{
  "slug": "js_undefined",
  "course": "js",
  "order": 96,
  "url": "/js/js_undefined.asp",
  "title": "JavaScript undefined",
  "blocks": [
    {
      "type": "h1",
      "text": "JavaScript undefined"
    },
    {
      "type": "p",
      "text": "In JavaScript, a variable without a value has the value undefined."
    },
    {
      "type": "p",
      "text": "The type is also undefined."
    },
    {
      "type": "h2",
      "text": "Undefined Variables"
    },
    {
      "type": "p",
      "text": "A variable declared without a value will automatically have the value undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "let car;\n\ndocument.getElementById(\"demo\").innerHTML = car;",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_undefined_variable"
    },
    {
      "type": "h2",
      "text": "The Type of undefined"
    },
    {
      "type": "p",
      "text": "You can use typeof to check if a variable is undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "let car;\n\ndocument.getElementById(\"demo\").innerHTML = typeof car;",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_undefined_typeof"
    },
    {
      "type": "h2",
      "text": "Empty Values"
    },
    {
      "type": "p",
      "text": "An empty string has a value and a type."
    },
    {
      "type": "p",
      "text": "It is not the same as undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "let text = \"\";\n\ndocument.getElementById(\"demo\").innerHTML =\n\ntext + \"<br>\" + typeof text;",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_undefined_empty"
    },
    {
      "type": "h2",
      "text": "Objects and undefined"
    },
    {
      "type": "p",
      "text": "Accessing a non-existing object property returns undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "const person = {firstName:\"John\", lastName:\"Doe\"};\n\ndocument.getElementById(\"demo\").innerHTML = person.age;",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_undefined_property"
    },
    {
      "type": "h2",
      "text": "Functions and undefined"
    },
    {
      "type": "p",
      "text": "A function without a return value returns undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "function myFunction() {\n\n  let x = 5;\n\n}\n\ndocument.getElementById(\"demo\").innerHTML = myFunction();",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryjs_undefined_function"
    },
    {
      "type": "h2",
      "text": "You Can Empty an Object"
    },
    {
      "type": "p",
      "text": "Objects can be emptied by setting the value to undefined."
    },
    {
      "type": "code",
      "lang": "js",
      "text": "const person = {firstName:\"John\", lastName:\"Doe\"};\n\nperson = undefined;",
      "caption": "Example"
    },
    {
      "type": "p",
      "text": "Objects can also be emptied by setting the value to null."
    },
    {
      "type": "h2",
      "text": "Note"
    },
    {
      "type": "p",
      "text": "undefined is a JavaScript value."
    },
    {
      "type": "p",
      "text": "It means that a variable has been declared, but no value has been assigned."
    }
  ]
}
