   "text": "React ES6 Ternary Operator"
  },
  {
   "type": "h2",
   "text": "Ternary Operator"
  },
  {
   "type": "p",
   "text": "The ternary operator is a simplified conditional operator like if / else."
  },
  {
   "type": "p",
   "text": "Syntax: condition ? <expression if true> : <expression if false>"
  },
  {
   "type": "p",
   "text": "Here is an example using if / else:"
  },
  {
   "type": "code",
   "lang": "text",
   "text": "if (authenticated) {\n  renderApp();\n} else {\n  renderLogin();\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryreact_es6_ternary1"
  },
  {
   "type": "p",
   "text": "Here is the same example using a ternary operator:"
  },
  {
   "type": "code",
   "lang": "text",
   "text": "authenticated ? renderApp() : renderLogin();",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryreact_es6_ternary2"
  }
 ]
}