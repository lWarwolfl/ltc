{
  "slug": "css_table_align",
  "course": "css",
  "order": 61,
  "url": "/css/css_table_align.asp",
  "title": "CSS Table Alignment",
  "blocks": [
    {
      "type": "h1",
      "text": "CSS Table Alignment"
    },
    {
      "type": "h2",
      "text": "Horizontal Alignment"
    },
    {
      "type": "p",
      "text": "The CSS text-align property is used to set the horizontal alignment\nof the content in <th> or <td>."
    },
    {
      "type": "p",
      "text": "This property can have one of the following values:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "left - Aligns the text to the left",
        "right - Aligns the text to the right",
        "center - Centers the text"
      ]
    },
    {
      "type": "p",
      "text": "Note: By default, the content of <th> elements are\ncenter-aligned and the content of <td> elements are left-aligned!"
    },
    {
      "type": "h2",
      "text": "CSS text-align: center"
    },
    {
      "type": "p",
      "text": "To center-align the content of <td> elements, use text-align: center:"
    },
    {
      "type": "table",
      "headers": ["Firstname", "Lastname", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "td\n{\n\ntext-align: center;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_align_center"
    },
    {
      "type": "h2",
      "text": "CSS text-align: left"
    },
    {
      "type": "p",
      "text": "To force the content of <th> elements to be\nleft-aligned, use text-align: left on <th>\nelements:"
    },
    {
      "type": "table",
      "headers": ["Firstname", "Lastname", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "th\n{\n\ntext-align: left;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_align"
    },
    {
      "type": "h2",
      "text": "Vertical Alignment"
    },
    {
      "type": "p",
      "text": "The CSS\nvertical-align property sets the vertical alignment (like top, bottom, or middle)\nof the content in <th> or <td>."
    },
    {
      "type": "p",
      "text": "Note: By default, the vertical alignment of the content in a table is middle (for both <th>\nand <td> elements)."
    },
    {
      "type": "p",
      "text": "The following example sets the vertical text alignment to bottom for <td> elements:"
    },
    {
      "type": "table",
      "headers": ["Firstname", "Lastname", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "td\n{\n\nheight: 50px;\n\nvertical-align: bottom;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_vertical-align"
    }
  ]
}
