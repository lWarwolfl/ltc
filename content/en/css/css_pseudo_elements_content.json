 "url": "/css/css_pseudo_elements_content.asp",
 "title": "CSS Pseudo-elements for Content",
 "blocks": [
  {
   "type": "h1",
   "text": "CSS Pseudo-elements for Content"
  },
  {
   "type": "h2",
   "text": "Pseudo-elements for Content"
  },
  {
   "type": "p",
   "text": "Pseudo-elements for content allow you to insert content before or after elements, style list markers, and more."
  },
  {
   "type": "h2",
   "text": "The CSS ::before Pseudo-element"
  },
  {
   "type": "p",
   "text": "The ::before pseudo-element\nis used to insert some content before the content of a specified element."
  },
  {
   "type": "p",
   "text": "Use the\ncontent property to specify the content to insert."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "h3::before\n{\n\n  content: url(smiley.gif);\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_before"
  },
  {
   "type": "h2",
   "text": "The CSS ::after Pseudo-element"
  },
  {
   "type": "p",
   "text": "The ::after pseudo-element\nis used to insert some content after the content of a specified element."
  },
  {
   "type": "p",
   "text": "Use the\ncontent property to specify the content to insert."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "h3::after\n{\n\n  content: url(smiley.gif);\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_after"
  },
  {
   "type": "h2",
   "text": "The CSS ::marker Pseudo-element"
  },
  {
   "type": "p",
   "text": "The ::marker pseudo-element\nis used to style the list item markers."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "::marker {\n\n  color: red;\n  font-size: 23px;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_marker"
  },
  {
   "type": "h2",
   "text": "The CSS ::selection Pseudo-element"
  },
  {
   "type": "p",
   "text": "The ::selection pseudo-element is used to style the part of a text that is selected by a user."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "::selection {\n  color: red;\n\nbackground: yellow;\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_selection"
  },
  {
   "type": "h2",
   "text": "The CSS ::backdrop Pseudo-element"
  },
  {
   "type": "p",
   "text": "The ::backdrop pseudo-element\nis used to style the viewbox behind a dialog box or popover element."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "dialog::backdrop {\n  background-color: lightgreen;\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_backdrop"
  },
  {
   "type": "h2",
   "text": "CSS Pseudo-elements Reference"
  },
  {
   "type": "note",
   "variant": "note",
   "text": "For a complete list of all CSS Pseudo-elements, visit our CSS Pseudo-elements Reference."
  }
 ]
}