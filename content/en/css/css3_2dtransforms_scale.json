{
  "slug": "css3_2dtransforms_scale",
  "course": "css",
  "order": 129,
  "url": "/css/css3_2dtransforms_scale.asp",
  "title": "CSS 2D Transform Scale",
  "blocks": [
    {
      "type": "h1",
      "text": "CSS 2D Transform Scale"
    },
    {
      "type": "h2",
      "text": "The CSS scale() Function"
    },
    {
      "type": "p",
      "text": "The scale() function increases or decreases the size of an element (according to the parameters given for the width and height)."
    },
    {
      "type": "p",
      "text": "The following example increases the <div> element to be two times of its original width, and three times of its original height:"
    },
    {
      "type": "image",
      "src": "https://www.w3schools.com/transform_scale.gif",
      "alt": "Scale"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scale(2, 3);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scale"
    },
    {
      "type": "p",
      "text": "The following example decreases the <div> element to be half of its original width and height:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scale(0.5, 0.5);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scale2"
    },
    {
      "type": "h2",
      "text": "The CSS scaleX() Function"
    },
    {
      "type": "p",
      "text": "The scaleX() function increases or decreases the\nwidth of an element."
    },
    {
      "type": "p",
      "text": "The following example increases the <div> element to be two times of its original width:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scaleX(2);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scaleX"
    },
    {
      "type": "p",
      "text": "The following example decreases the <div> element to be half of its original width:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scaleX(0.5);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scaleX2"
    },
    {
      "type": "h2",
      "text": "The CSS scaleY() Function"
    },
    {
      "type": "p",
      "text": "The scaleY() function increases or decreases the\nheight of an element."
    },
    {
      "type": "p",
      "text": "The following example increases the <div> element to be three times of its original height:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scaleY(3);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scaleY"
    },
    {
      "type": "p",
      "text": "The following example decreases the <div> element to be half of its original height:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "div {\n\n  transform: scaleY(0.5);\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss3_transform_scaleY2"
    }
  ]
}
