    {
      "type": "h2",
      "text": "CSS justify-content Property"
    },
    {
      "type": "p",
      "text": "The justify-content property\naligns the flex items along the main-axis (horizontally)."
    },
    {
      "type": "p",
      "text": "This property can have one of the following values:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "center",
        "flex-start (default)",
        "flex-end",
        "space-around",
        "space-between",
        "space-evenly"
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".flex-container {\n\n  display: flex;\n\n  justify-content: center;\n}",
      "caption": "Example"
