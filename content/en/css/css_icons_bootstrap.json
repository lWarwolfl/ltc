   "text": "Bootstrap Icons"
  },
  {
   "type": "p",
   "text": "To use the Bootstrap glyphicons, add the following line inside the <head> section of your HTML page:"
  },
  {
   "type": "p",
   "text": "<link rel=\"stylesheet\"\nhref=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\">"
  },
  {
   "type": "p",
   "text": "Note: No downloading or installation is required!"
  },
  {
   "type": "code",
   "lang": "html",
   "text": "<!DOCTYPE html>\n<html>\n<head>\n\n     <link rel=\"stylesheet\"\n  href=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css\">\n</head>\n<body>\n\n<i class=\"glyphicon glyphicon-cloud\"></i>\n<i class=\"glyphicon  glyphicon-remove\"></i>\n<i class=\"glyphicon glyphicon-user\"></i>\n<i  class=\"glyphicon glyphicon-envelope\"></i>\n<i class=\"glyphicon glyphicon-thumbs-up\"></i>\n\n  </body>\n</html>",
   "caption": "Example"
  },
