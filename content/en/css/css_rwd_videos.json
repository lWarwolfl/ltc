{
  "slug": "css_rwd_videos",
  "course": "css",
  "order": 193,
  "url": "/css/css_rwd_videos.asp",
  "title": "Responsive Web Design - Videos",
  "blocks": [
    {
      "type": "h1",
      "text": "Responsive Web Design - Videos"
    },
    {
      "type": "h2",
      "text": "Using The width Property"
    },
    {
      "type": "p",
      "text": "If the width property is set to 100%, the video player will be\nresponsive and scale up and down:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "video {\n\n  width: 100%;\n  height: auto;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryresponsive_video2"
    },
    {
      "type": "p",
      "text": "Notice that in the example above, the video player can be scaled up to be larger\nthan its original size. A better solution, in many cases, will be to use the\nmax-width property instead."
    },
    {
      "type": "h2",
      "text": "Using The max-width Property"
    },
    {
      "type": "p",
      "text": "If the\nmax-width property is set to 100%, the video player will scale down if it has to, but never scale up to be larger than its\noriginal size:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "video {\n\n    max-width: 100%;\n  height: auto;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryresponsive_video"
    },
    {
      "type": "h2",
      "text": "Add a Video to the Example Web Page"
    },
    {
      "type": "p",
      "text": "We want to add a video in our example web page. The video will be resized to always take up all the available space:"
    },
    {
      "type": "code",
      "lang": "css",
      "text": "video {\n\n    width: 100%;\n  height: auto;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryresponsive_video3"
    }
  ]
}
