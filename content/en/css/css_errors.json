  "url": "/css/css_errors.asp",
  "title": "CSS Errors",
  "blocks": [
    {
      "type": "h1",
      "text": "CSS Errors"
    },
    {
      "type": "h2",
      "text": "CSS Errors"
    },
    {
      "type": "p",
      "text": "Errors in CSS can lead to unexpected behavior or styles not being applied correctly."
    },
    {
      "type": "p",
      "text": "This page shows common CSS mistakes, and how to avoid them."
    },
    {
      "type": "h2",
      "text": "Missing Semicolons"
    },
    {
      "type": "p",
      "text": "Forgetting a semicolon at the end of a property declaration can break the style rule."
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".bad {\n\n  color: red\n\n  background-color: yellow;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_error_1"
    },
    {
      "type": "h2",
      "text": "Invalid Property Names"
    },
    {
      "type": "p",
      "text": "Using a property name that does not exist will simply be ignored by the browser."
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".bad {\n\n  colr: blue;\n\n  font-size: 16px;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_error_2"
    },
    {
      "type": "h2",
      "text": "Invalid Values"
    },
    {
      "type": "p",
      "text": "Correct properties but invalid values will also be ignored."
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".bad {\n\n  width: -100px;\n\n  color: green;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_error_3"
    },
    {
      "type": "h2",
      "text": "Unclosed Braces"
    },
    {
      "type": "p",
      "text": "If you forget to close a brace }, the entire rule may be ignored."
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".bad {\n\n  padding: 20px;\n\n  margin: 10px;",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_error_4"
    },
    {
      "type": "h2",
      "text": "Extra Colons or Braces"
    },
    {
      "type": "p",
      "text": "Typos like extra colons or misplaced braces can cause rules to break."
    },
    {
      "type": "code",
      "lang": "css",
      "text": ".bad {\n\n  color:: blue;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_error_5"
    },
    {
      "type": "h2",
      "text": "Tips to Avoid CSS Errors"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "Use a code editor with syntax highlighting.",
        "Validate your CSS with a CSS linter or validator.",
        "Write CSS in small sections and test frequently."
      ]
    }
  ]
}
