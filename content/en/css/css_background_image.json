 "title": "CSS Background Image",
 "blocks": [
  {
   "type": "h1",
   "text": "CSS Background Image"
  },
  {
   "type": "h2",
   "text": "CSS background-image"
  },
  {
   "type": "p",
   "text": "The background-image property specifies an image to use as the background of an element."
  },
  {
   "type": "p",
   "text": "By default, the image is repeated so it covers the entire element."
  },
  {
   "type": "code",
   "lang": "css",
   "text": "body {\n  background-image: url(\"paper.gif\");\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_background-image"
  },
  {
   "type": "code",
   "lang": "css",
   "text": "body {\n  background-image: url(\"bgdesert.jpg\");\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_background-image_bad"
  },
  {
   "type": "note",
   "variant": "note",
   "text": "When using a background image, use an image that does not disturb the text."
  },
  {
   "type": "p",
   "text": "The background image can also be set for specific elements, like the <p> element:"
  },
  {
   "type": "code",
   "lang": "css",
   "text": "p {\n  background-image: url(\"paper.gif\");\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_background-image_p"
  },
  {
   "type": "h2",
   "text": "The CSS Background Image Property"
  },
