{
  "slug": "css_table_style",
  "course": "css",
  "order": 62,
  "url": "/css/css_table_style.asp",
  "title": "CSS Table Styling",
  "blocks": [
    {
      "type": "h1",
      "text": "CSS Table Styling"
    },
    {
      "type": "h2",
      "text": "CSS Table Padding"
    },
    {
      "type": "p",
      "text": "To add some more space between the inner borders and the content in a table, use the\npadding property on\n<td> and <th> elements:"
    },
    {
      "type": "table",
      "headers": ["First Name", "Last Name", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "th, td\n{\n\npadding: 10px;\n  text-align: left;\n\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_padding"
    },
    {
      "type": "h2",
      "text": "CSS Horizontal Dividers"
    },
    {
      "type": "p",
      "text": "To create horizontal dividers for a table, add the border-bottom property to <th> and <td>\nelements:"
    },
    {
      "type": "table",
      "headers": ["First Name", "Last Name", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "th, td {\n  border-bottom: 1px solid #ddd;\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_border_divider"
    },
    {
      "type": "h2",
      "text": "CSS Hoverable Table"
    },
    {
      "type": "p",
      "text": "Use the CSS :hover selector on <tr> to highlight table rows on mouse\nover:"
    },
    {
      "type": "table",
      "headers": ["First Name", "Last Name", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "tr:hover {background-color: coral;}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_hover"
    },
    {
      "type": "h2",
      "text": "CSS Zebra-striped Table"
    },
    {
      "type": "p",
      "text": "For zebra-striped tables, use the\nnth-child() selector and add a\nbackground-color to all even (or odd) table rows:"
    },
    {
      "type": "table",
      "headers": ["First Name", "Last Name", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "tr:nth-child(even) {background-color: #f2f2f2;}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_striped"
    },
    {
      "type": "h2",
      "text": "CSS Table Color"
    },
    {
      "type": "p",
      "text": "The example below specifies a background color and a text color for the <th> elements:"
    },
    {
      "type": "table",
      "headers": ["First Name", "Last Name", "Savings"],
      "rows": [
        ["Peter", "Griffin", "$100"],
        ["Lois", "Griffin", "$150"],
        ["Joe", "Swanson", "$300"]
      ]
    },
    {
      "type": "code",
      "lang": "css",
      "text": "th {\n  background-color: #04AA6D;\n  color: white;\n}",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_color"
    }
  ]
}
