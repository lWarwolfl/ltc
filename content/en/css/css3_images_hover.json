      "type": "code",
      "lang": "css",
      "text": "@media only screen and (max-width: 768px) {\n  div.gallery-item {\n\n  width: calc(50% - 20px);\n  }\n}\n\n@media only screen and (max-width: 480px) {\n\n  div.gallery-item {\n    width: calc(100% - 20px);\n  }\n}",
