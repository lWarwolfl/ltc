{
 "slug": "css_table_size",
 "course": "css",
 "order": 60,
 "url": "/css/css_table_size.asp",
 "title": "CSS Table Size (Width and Height)",
 "blocks": [
  {
   "type": "h1",
   "text": "CSS Table Size (Width and Height)"
  },
  {
   "type": "h2",
   "text": "CSS Table Width"
  },
  {
   "type": "p",
   "text": "The CSS width\nproperty is used to set the width of a table."
  },
  {
   "type": "p",
   "text": "The width can be set:"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "in percent (%)",
    "as a fixed length (px)",
    "by the auto keyword"
   ]
  },
  {
   "type": "h2",
   "text": "CSS Table Width in Percent"
  },
  {
   "type": "p",
   "text": "To create a table that spans the entire screen (full-width), use\nwidth: 100%;:"
  },
  {
   "type": "table",
   "headers": [
    "Firstname",
    "Lastname",
    "Savings"
   ],
   "rows": [
    [
     "Peter",
     "Griffin",
     "$100"
    ],
    [
     "Lois",
     "Griffin",
     "$150"
    ],
    [
     "Joe",
     "Swanson",
     "$300"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "css",
   "text": "table\n{\n\n  width: 100%;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_width"
  },
  {
   "type": "p",
   "text": "To create a table that spans half the page, use width: 50%;:"
  },
  {
   "type": "table",
   "headers": [
    "Firstname",
    "Lastname",
    "Savings"
   ],
   "rows": [
    [
     "Peter",
     "Griffin",
     "$100"
    ],
    [
     "Lois",
     "Griffin",
     "$150"
    ],
    [
     "Joe",
     "Swanson",
     "$300"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "css",
   "text": "table\n{\n\n  width: 50%;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_width2"
  },
  {
   "type": "h2",
   "text": "CSS Table Width in a Fixed Width"
  },
  {
   "type": "p",
   "text": "To create a table with a fixed width, use width: 500px:"
  },
  {
   "type": "table",
   "headers": [
    "Firstname",
    "Lastname",
    "Savings"
   ],
   "rows": [
    [
     "Peter",
     "Griffin",
     "$100"
    ],
    [
     "Lois",
     "Griffin",
     "$150"
    ],
    [
     "Joe",
     "Swanson",
     "$300"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "css",
   "text": "table\n{\n\n  width: 500px;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_width3"
  },
  {
   "type": "h2",
   "text": "CSS Table Width Using auto"
  },
  {
   "type": "p",
   "text": "To let the browser calculate the width, use width: auto;:"
  },
  {
   "type": "table",
   "headers": [
    "Firstname",
    "Lastname",
    "Savings"
   ],
   "rows": [
    [
     "Peter",
     "Griffin",
     "$100"
    ],
    [
     "Lois",
     "Griffin",
     "$150"
    ],
    [
     "Joe",
     "Swanson",
     "$300"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "css",
   "text": "table\n{\n\n  width: auto;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_width4"
  },
  {
   "type": "h2",
   "text": "CSS Table Height"
  },
  {
   "type": "p",
   "text": "The CSS height\nproperty is used to set the height of a table."
  },
  {
   "type": "p",
   "text": "The height can be set:"
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    "in percent (%)",
    "as a fixed length (px)",
    "by the auto keyword"
   ]
  },
  {
   "type": "p",
   "text": "The example below sets the height of the table headers (<th>) to 70px:"
  },
  {
   "type": "table",
   "headers": [
    "Firstname",
    "Lastname",
    "Savings"
   ],
   "rows": [
    [
     "Peter",
     "Griffin",
     "$100"
    ],
    [
     "Lois",
     "Griffin",
     "$150"
    ],
    [
     "Joe",
     "Swanson",
     "$300"
    ]
   ]
  },
  {
   "type": "code",
   "lang": "css",
   "text": "th\n{\n\n  height: 70px;\n\n}",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=trycss_table_height"
  }
 ]
}