  "title": "HTML Table Colspan & Rowspan",
  "blocks": [
    {
      "type": "h1",
      "text": "HTML Table Colspan & Rowspan"
    },
    {
      "type": "p",
      "text": "HTML tables can have cells that span over multiple rows and/or columns."
    },
    {
      "type": "table",
      "headers": [],
      "rows": [
        ["NAME", ""],
        ["", "", ""],
        ["", "", ""],
        ["", "", ""],
        ["", "", ""]
      ]
    },
    {
      "type": "table",
      "headers": [],
      "rows": [
        ["APRIL", "", ""],
        ["", ""],
        ["", ""],
        ["", "", ""],
        ["", "", ""]
      ]
    },
    {
      "type": "table",
      "headers": ["2022"],
      "rows": [["", "", ""], ["FIESTA", ""], [""], ["", "", ""]]
    },
    {
      "type": "h2",
      "text": "HTML Table - Colspan"
    },
    {
      "type": "p",
      "text": "To make a cell span over multiple columns, use the colspan attribute:"
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<table>\n  <tr>\n    <th colspan=\"2\">Name</th>\n\n  <th>Age</th>\n  </tr>\n  <tr>\n\n  <td>Jill</td>\n    <td>Smith</td>\n\n  <td>43</td>\n  </tr>\n  <tr>\n    <td>Eve</td>\n\n  <td>Jackson</td>\n    <td>57</td>\n  </tr>\n</table>",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryhtml_table_colspan2"
    },
    {
      "type": "note",
      "variant": "note",
      "text": "The value of the colspan attribute represents the number of columns to span."
    },
    {
      "type": "h2",
      "text": "HTML Table - Rowspan"
    },
    {
      "type": "p",
      "text": "To make a cell span over multiple rows, use the rowspan attribute:"
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<table>\n  <tr>\n    <th>Name</th>\n\n  <td>Jill</td>\n  </tr>\n  <tr>\n    <th rowspan=\"2\">Phone</th>\n\n  <td>555-1234</td>\n  </tr>\n  <tr>\n\n  <td>555-8745</td>\n</tr>\n</table>",
      "caption": "Example"
    },
    {
      "type": "tryit",
      "url": "https://www.w3schools.com/tryit.asp?filename=tryhtml_table_rowspan2"
    },
    {
      "type": "note",
      "variant": "note",
      "text": "The value of the rowspan attribute represents the number of\nrows to span."
    }
  ]
}
