  },
  {
   "type": "p",
   "text": "To set the size of a specific column, add the style\nattribute on a <th> or\n<td> element:"
  },
  {
   "type": "code",
   "lang": "html",
   "text": "<table style=\"width:100%\">\n\n<tr>\n    <th style=\"width:70%\">Firstname</th>\n\n    <th>Lastname</th>\n    <th>Age</th>\n\n</tr>\n\n<tr>\n    <td>Jill</td>\n\n    <td>Smith</td>\n    <td>50</td>\n\n</tr>\n  <tr>\n    <td>Eve</td>\n\n    <td>Jackson</td>\n    <td>94</td>\n\n  </tr>\n</table>",
   "caption": "Example"
  },
  {
   "type": "tryit",
   "url": "https://www.w3schools.com/tryit.asp?filename=tryhtml_table_column_width"
  },
