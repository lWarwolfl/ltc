{
  "slug": "html_charset",
  "course": "html",
  "order": 54,
  "url": "/html/html_charset.asp",
  "title": "HTML Encoding (Character Sets)",
  "blocks": [
    {
      "type": "h1",
      "text": "HTML Encoding (Character Sets)"
    },
    {
      "type": "h2",
      "text": "The HTML charset Attribute"
    },
    {
      "type": "p",
      "text": "To display an HTML page correctly, a web browser must know which character set to use."
    },
    {
      "type": "p",
      "text": "The character set is specified in the <meta> tag:"
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<meta charset=\"UTF-8\">",
      "caption": null
    },
    {
      "type": "p",
      "text": "The HTML specification encourages web developers to use the UTF-8 character set."
    },
    {
      "type": "p",
      "text": "UTF-8 covers almost all of the characters and symbols in the world!"
    },
    {
      "type": "h2",
      "text": "Learn More:"
    },
    {
      "type": "p",
      "text": "Full UTF-8 Reference"
    },
    {
      "type": "h2",
      "text": "The ASCII Character Set"
    },
    {
      "type": "p",
      "text": "ASCII was the first character encoding standard for the web."
    },
    {
      "type": "p",
      "text": "It defined 128 different latin characters that could be used on the internet:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "English letters (a-z and A-Z)",
        "Numbers (0-9)",
        "Some special characters: ! $ + - ( ) @ < > . # ?"
      ]
    },
    {
      "type": "h2",
      "text": "The ANSI Character Set"
    },
    {
      "type": "p",
      "text": "ANSI (Windows-1252) was the first Windows character set:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "Identical to ASCII for the first 127 characters",
        "Special characters from 128 to 159",
        "Identical to UTF-8 from 160 to 255"
      ]
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<meta charset=\"Windows-1252\">",
      "caption": null
    },
    {
      "type": "h2",
      "text": "The ISO-8859-1 Character Set"
    },
    {
      "type": "p",
      "text": "The default character set for HTML 4 was ISO-8859-1."
    },
    {
      "type": "p",
      "text": "It supported 256 characters:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "Identical to ASCII for the first 127 characters",
        "Does not use the characters from 128 to 159",
        "Identical to ANSI and UTF-8 from 160 to 255"
      ]
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<meta http-equiv=\"Content-Type\" content=\"text/html;charset=ISO-8859-1\">",
      "caption": "HTML 4 Example"
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<meta charset=\"ISO-8859-1\">",
      "caption": "HTML 4 Example"
    },
    {
      "type": "h2",
      "text": "The UTF-8 Character Set"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "Identical to ASCII for the values from 0 to 127",
        "Does not use the characters from 128 to 159",
        "Identical to ANSI and 8859-1 from 160 to 255",
        "Continues from the value 256 to 10 000 characters"
      ]
    },
    {
      "type": "code",
      "lang": "html",
      "text": "<meta charset=\"UTF-8\">",
      "caption": null
    },
    {
      "type": "h2",
      "text": "Learn More:"
    },
    {
      "type": "p",
      "text": "Full UTF-8 Reference"
    },
    {
      "type": "h2",
      "text": "HTML UTF-8 Characters"
    }
  ]
}
